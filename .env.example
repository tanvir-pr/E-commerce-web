# Copy to .env before `docker compose up`.
# Compose overrides DATABASE_URL and REDIS_URL for the api and worker
# so those processes use the Docker service names (postgres, redis).
#
# API_INTERNAL_URL (also accepted as API_URL) is the Next.js server-side proxy
# target for /api/v1. Compose sets http://api:8000. For `next dev` on the host
# without Compose, set API_INTERNAL_URL=http://localhost:8000.
#
# Open the site as http://localhost:3000 (not 127.0.0.1) so Secure __Host- cookies work.
# BREACH_CHECK=stub accepts any password of 10+ characters (no HIBP call).

APP_ENV=local
DATABASE_URL=postgresql+asyncpg://store:store@postgres:5432/store
REDIS_URL=redis://redis:6379/0
CORS_ORIGIN=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3001
API_INTERNAL_URL=http://api:8000
API_URL=http://api:8000
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
JWT_SECRET=local-dev-only-change-me
BREACH_CHECK=stub
SEED_SUPERADMIN_EMAIL=owner@example.com
SEED_SUPERADMIN_PASSWORD=ChangeMeNow1
TOTP_ENCRYPTION_KEY=_-Ya7B3qukwFBFcl2y52RF4qvs52ThkeoxVKWZ9Jnq8=
TOTP_ISSUER=Store
